# এই ফাইলের নাম কপি করে ".env" বানিয়ে নিজের তথ্য বসান
# cp .env.example .env

DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=network_automation

# নিচের কমান্ড দিয়ে বানান: python -c "import secrets; print(secrets.token_hex(32))"
# ⚠️ এটা ছাড়া অ্যাপ চালুই হবে না (নিরাপত্তার জন্য কোনো default রাখা হয়নি)
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=120

# নিচের কমান্ড দিয়ে বানান: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ এটা দিয়ে devices.ssh_password এনক্রিপ্ট/ডিক্রিপ্ট হয়, এটা ছাড়াও অ্যাপ চালু হবে না
FERNET_KEY=
